# Public URL of the site (used for canonical URLs, sitemap, Open Graph).
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL if this is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact address shown on the Contact and Privacy pages.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# ---- Monetization (keep disabled while developing) ----
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=            # ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_TOOL=   # numeric ad unit id
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=   # numeric ad unit id
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=      # numeric ad unit id

# ---- Analytics / Search Console (optional) ----
NEXT_PUBLIC_GA_ID=                     # G-XXXXXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION=          # content value of the Google site-verification meta tag
